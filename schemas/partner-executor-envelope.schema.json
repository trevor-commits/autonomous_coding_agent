{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-coding-agent.local/schemas/partner-executor-envelope.schema.json",
  "title": "Partner Executor Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "wake_id",
    "proposal_id",
    "proposal_hash",
    "approval_id",
    "approval_hash",
    "approval_binding",
    "executor_id",
    "strategy",
    "builder_model",
    "builder_reasoning_effort",
    "run_contract",
    "run_contract_hash",
    "capability_classes",
    "risk_level",
    "created_at",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "envelope_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "wake_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "proposal_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "proposal_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "approval_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_binding": {
      "$ref": "https://autonomous-coding-agent.local/schemas/partner-approval.schema.json"
    },
    "executor_id": {"const": "autonomous-coding-agent"},
    "strategy": {"enum": ["simple", "claude"]},
    "builder_model": {"const": "gpt-5.5"},
    "builder_reasoning_effort": {"const": "high"},
    "run_contract": {
      "$ref": "https://autonomous-coding-agent.local/schemas/run-contract.schema.json"
    },
    "run_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capability_classes": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 80}
    },
    "risk_level": {"enum": ["low", "medium", "high"]},
    "created_at": {"type": "string", "minLength": 20, "maxLength": 40},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
