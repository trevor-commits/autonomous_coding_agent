{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-coding-agent.local/schemas/partner-decision.schema.json",
  "title": "Partner Wake Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "wake_id",
    "idempotency_key",
    "identity_hash",
    "policy_version",
    "decision_type",
    "reason_codes",
    "evidence_ids",
    "payload",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "decision_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "wake_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 240},
    "identity_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "decision_type": {"enum": ["no_op", "proposal", "executor_envelope", "lesson_candidate", "blocked"]},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,79}$"}
    },
    "evidence_ids": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "payload": {"type": "object"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
