{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-coding-agent.local/schemas/partner-lesson-candidate.schema.json",
  "title": "Partner Lesson Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lesson_id",
    "source_outcome_id",
    "source_receipt_hash",
    "scope",
    "summary",
    "confidence",
    "expires_at",
    "promotion_target",
    "identity_amendment_required",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "lesson_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "source_outcome_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "source_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope": {"enum": ["ranking", "communication", "workflow", "identity"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "expires_at": {"type": "string", "minLength": 20, "maxLength": 40},
    "promotion_target": {"enum": ["benefit_ledger", "project_memory", "rule_failure", "identity_amendment"]},
    "identity_amendment_required": {"type": "boolean"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
