{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-coding-agent.local/schemas/partner-identity.schema.json",
  "title": "Partner Identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "pronouns",
    "values",
    "voice_traits",
    "interests",
    "dislikes",
    "relationship_boundaries",
    "source_labels"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "pronouns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 40}
    },
    "values": {"$ref": "#/$defs/configuredItems"},
    "voice_traits": {"$ref": "#/$defs/configuredItems"},
    "interests": {"$ref": "#/$defs/configuredItems"},
    "dislikes": {"$ref": "#/$defs/configuredItems"},
    "relationship_boundaries": {"$ref": "#/$defs/configuredItems"},
    "source_labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configured", "operator_approved", "inferred", "generated"],
      "properties": {
        "configured": {"type": "string", "minLength": 1, "maxLength": 120},
        "operator_approved": {"type": "string", "minLength": 1, "maxLength": 120},
        "inferred": {"type": "string", "minLength": 1, "maxLength": 120},
        "generated": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "configuredItems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
          "value": {"type": "string", "minLength": 1, "maxLength": 1000},
          "source": {"enum": ["configured", "operator_approved"]}
        }
      }
    }
  }
}
