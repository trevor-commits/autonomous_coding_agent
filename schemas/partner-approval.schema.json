{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-coding-agent.local/schemas/partner-approval.schema.json",
  "title": "Partner Approval Binding",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "approval_id", "amendment_id", "amendment_hash", "approved"],
      "properties": {
        "schema_version": {"const": "1"},
        "approval_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "amendment_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "amendment_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approved": {"type": "boolean"},
        "approved_at": {"type": "string", "minLength": 20, "maxLength": 40},
        "expires_at": {"type": "string", "minLength": 20, "maxLength": 40}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "approval_id",
        "approval_kind",
        "subject_id",
        "subject_hash",
        "approved",
        "approved_at",
        "expires_at"
      ],
      "properties": {
        "schema_version": {"const": "1"},
        "approval_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "approval_kind": {"enum": ["proposal", "identity_amendment", "capability_exception"]},
        "subject_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "subject_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approved": {"type": "boolean"},
        "approved_at": {"type": "string", "minLength": 20, "maxLength": 40},
        "expires_at": {"type": "string", "minLength": 20, "maxLength": 40},
        "capability_classes": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        }
      }
    }
  ]
}
